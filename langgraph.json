{
  "python_version": "3.13",
  "source": {
    "kind": "uv",
    "root": "."
  },
  "graphs": {
    "main_agent": "deal_pilot.agents.main:factory_with_trace",
    "delete_old_trace": "deal_pilot.crons.delete_old_trace:graph"
  },
  "env": ".env",
  "auth": {
    "path": "deal_pilot.security.auth:auth",
    "disable_studio_auth": true
  },
  "http": {
    "app": "deal_pilot.app.main:app",
    "enable_custom_route_auth": false
  }
}
